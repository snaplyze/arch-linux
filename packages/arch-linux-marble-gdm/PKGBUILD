prepare() {
    local generated="${srcdir}/generated"
    local dconf_source="${generated}/dconf-defaults.d"
    local reviewed_license_root="${generated}/reviewed-licenses"
    local upstream_license_root="${generated}/upstream-license-sources"
    local license_file
    local package_info
    local stock_resource="${generated}/gnome-shell-theme.gresource"
    local stock_dark_css="${generated}/gnome-shell-dark.stock.css"
    local marble_css="${srcdir}/${_theme}/gnome-shell/gnome-shell.css"

    mkdir -p -- "${generated}"
    install -d -m 0755 -- "${reviewed_license_root}" "${upstream_license_root}"
    for license_file in \
        COPYING-GNOME-Shell \
        COPYING-GNOME-Shell-Sass \
        LICENSE-LGPL-2.1-only \
        LICENSE-Marble \
        LICENSE-project \
        NOTICE-GNOME-Shell-common.scss \
        THIRD-PARTY-NOTICES; do
        install -m 0644 -- "${srcdir}/${license_file}" \
            "${reviewed_license_root}/${license_file}"
    done
    install -m 0644 -- \
        "${srcdir}/SPDX-LGPL-2.1-only-${_spdx_license_list_commit}.txt" \
        "${upstream_license_root}/SPDX-LGPL-2.1-only.txt"
    package_info="$(bsdtar -xOf "${srcdir}/${_arch_gnome_shell_archive}" .PKGINFO)"
    grep -Fqx "pkgname = gnome-shell" <<<"${package_info}"
    grep -Fqx "pkgver = ${_arch_gnome_shell_pkgver}" <<<"${package_info}"
    bsdtar -xOf "${srcdir}/${_arch_gnome_shell_archive}" \
        usr/share/gnome-shell/gnome-shell-theme.gresource >"${stock_resource}"
    echo "${_stock_resource_sha256}  ${stock_resource}" | sha256sum --check --status
    gresource extract "${stock_resource}" \
        /org/gnome/shell/theme/gnome-shell-dark.css >"${stock_dark_css}"
    echo "${_stock_dark_css_sha256}  ${stock_dark_css}" | sha256sum --check --status
    echo "${_marble_css_sha256}  ${marble_css}" | sha256sum --check --status
    python3 "${srcdir}/build-combined-css.py" \
        "${stock_dark_css}" "${marble_css}" "${generated}/gnome-shell.combined.css"

    # Keep a separately pinned GNOME 51 platform and composed payload.
    package_info="$(bsdtar -xOf "${srcdir}/${_arch_gnome_shell_51_archive}" .PKGINFO)"
    grep -Fqx "pkgname = gnome-shell" <<<"${package_info}"
    grep -Fqx "pkgver = ${_arch_gnome_shell_51_pkgver}" <<<"${package_info}"
    bsdtar -xOf "${srcdir}/${_arch_gnome_shell_51_archive}" \
        usr/share/gnome-shell/gnome-shell-theme.gresource >"${generated}/gnome-shell-51-theme.gresource"
    echo "${_stock_51_resource_sha256}  ${generated}/gnome-shell-51-theme.gresource" | sha256sum --check --status
    gresource extract "${generated}/gnome-shell-51-theme.gresource" \
        /org/gnome/shell/theme/gnome-shell-dark.css >"${generated}/gnome-shell-51-dark.stock.css"
    echo "${_stock_51_dark_css_sha256}  ${generated}/gnome-shell-51-dark.stock.css" | sha256sum --check --status
    python3 "${srcdir}/build-combined-css.py" \
        "${generated}/gnome-shell-51-dark.stock.css" "${marble_css}" "${generated}/gnome-shell-51.combined.css"
    install -d -m 0755 -- "${generated}/reviewed-licenses-51"
    for license_file in "${reviewed_license_root}"/*; do
        install -m 0644 -- "${license_file}" "${generated}/reviewed-licenses-51/"
    done
    install -m 0644 -- "${srcdir}/NOTICE-GNOME-Shell-51-common.scss" \
        "${generated}/reviewed-licenses-51/NOTICE-GNOME-Shell-common.scss"

    install -d -m 0755 -- "${dconf_source}/locks"
    install -m 0644 -- "${srcdir}/00-arch-linux-marble-gdm-icons" \
        "${dconf_source}/00-arch-linux-marble-gdm-icons"
    install -m 0644 -- "${srcdir}/icon-theme.lock" \
        "${dconf_source}/locks/icon-theme"
    dconf compile "${generated}/colloid-gdm-defaults" "${dconf_source}"
}

check() {
    local generated="${srcdir}/generated/gnome-shell.combined.css"
    local gnome_source="${srcdir}/gnome-shell-${_gnome_shell_commit}"
    local marble_source="${srcdir}/Marble-shell-theme-${_marble_commit}"
    local reviewed_license_root="${srcdir}/generated/reviewed-licenses"
    local theme_root="${srcdir}/${_theme}/gnome-shell"

    echo "${_combined_css_sha256}  ${generated}" | sha256sum --check --status
    echo "${_dconf_db_sha256}  ${srcdir}/generated/colloid-gdm-defaults" | \
        sha256sum --check --status
    echo "${_marble_css_sha256}  ${theme_root}/gnome-shell.css" | \
        sha256sum --check --status
    echo 'af5447861215e4a01617ce2e9dd329f9fc029ecf60a5b067d0abdd46b209b0c8  '"${theme_root}/calendar-event-disabled.svg" | \
        sha256sum --check --status
    echo 'a3250a2d1bf8c1cde2a3130b6d4343029f0ec7a88d54526117a6911c998c9827  '"${theme_root}/calendar-event-today.svg" | \
        sha256sum --check --status
    echo '3bed96bb050cb646d77f2cd12427249b4aa10fb4d32b1e9f9a8851079e5d8f78  '"${theme_root}/calendar-event.svg" | \
        sha256sum --check --status
    echo '7ce9aab6a382710de04d1e867db910c77df9bbece61d5aa5d211d2676c1a141c  '"${theme_root}/workspace-placeholder.svg" | \
        sha256sum --check --status
    test "$(find "${theme_root}" -type f | wc -l)" -eq 5
    test "$(grep -Fxc '/* Marble theme */' "${generated}")" -eq 1
    python3 "${srcdir}/verify-license-provenance.py" \
        "${gnome_source}/data/theme" \
        "${marble_source}/theme/gnome-shell" "${theme_root}" \
        "${reviewed_license_root}" \
        "${srcdir}/generated/upstream-license-sources/SPDX-LGPL-2.1-only.txt"

    echo "${_combined_51_css_sha256}  ${srcdir}/generated/gnome-shell-51.combined.css" | sha256sum --check --status
    python3 "${srcdir}/verify-license-provenance.py" \
        "${srcdir}/gnome-shell-${_gnome_shell_51_commit}/data/theme" \
        "${marble_source}/theme/gnome-shell" "${theme_root}" \
        "${srcdir}/generated/reviewed-licenses-51" \
        "${srcdir}/generated/upstream-license-sources/SPDX-LGPL-2.1-only.txt"

    local validation_profile="${srcdir}/generated/dconf-profile"
    local validation_config="${srcdir}/generated/dconf-config"
    install -d -m 0755 -- "${validation_config}/dconf"
    printf '%s\n' \
        'user-db:user' \
        "file-db:${srcdir}/generated/colloid-gdm-defaults" >"${validation_profile}"
    test "$(DCONF_PROFILE="${validation_profile}" XDG_CONFIG_HOME="${validation_config}" \
        gsettings get org.gnome.desktop.interface icon-theme)" = "'Colloid-Dark'"
    test "$(DCONF_PROFILE="${validation_profile}" XDG_CONFIG_HOME="${validation_config}" \
        gsettings writable org.gnome.desktop.interface icon-theme)" = 'false'
}

package() {
    local payload="${pkgdir}/usr/share/arch-linux-marble-gdm"
    local version_payload="${payload}/${pkgver}"
    local theme_payload="${version_payload}/theme"
    local source_theme="${srcdir}/${_theme}/gnome-shell"
    local reviewed_license_root="${srcdir}/generated/reviewed-licenses"
    local css_name asset

    install -Dm0644 "${source_theme}/gnome-shell.css" \
        "${version_payload}/reviewed/gnome-shell.css"
    for css_name in gnome-shell.css gnome-shell-dark.css gnome-shell-light.css; do
        install -Dm0644 "${srcdir}/generated/gnome-shell.combined.css" \
            "${theme_payload}/${css_name}"
    done
    for asset in \
        calendar-event-disabled.svg \
        calendar-event-today.svg \
        calendar-event.svg \
        workspace-placeholder.svg; do
        install -Dm0644 "${source_theme}/${asset}" "${theme_payload}/${asset}"
    done

    install -Dm0644 "${srcdir}/assets.sha256" "${payload}/assets.sha256"
    install -Dm0644 "${srcdir}/known-gnome-50.sha256" "${payload}/known-gnome-50.sha256"
    install -Dm0644 "${srcdir}/known-colloid-icons.sha256" \
        "${payload}/known-colloid-icons.sha256"
    install -Dm0644 "${srcdir}/dconf-profile" "${version_payload}/dconf/profile"
    install -Dm0644 "${srcdir}/generated/colloid-gdm-defaults" \
        "${version_payload}/dconf/colloid-gdm-defaults"
    install -Dm0644 "${srcdir}/00-arch-linux-marble-gdm-icons" \
        "${version_payload}/dconf/source/00-arch-linux-marble-gdm-icons"
    install -Dm0644 "${srcdir}/icon-theme.lock" \
        "${version_payload}/dconf/source/locks/icon-theme"
    install -Dm0644 "${srcdir}/50-arch-linux-marble-gdm.conf" \
        "${payload}/systemd/50-arch-linux-marble-gdm.conf"
    install -Dm0755 "${srcdir}/update-compatibility" \
        "${pkgdir}/usr/lib/arch-linux-marble-gdm/update-compatibility"
    install -Dm0644 "${srcdir}/40-arch-linux-marble-gdm-pre.hook" \
        "${pkgdir}/usr/share/libalpm/hooks/40-arch-linux-marble-gdm-pre.hook"
    install -Dm0644 "${srcdir}/zz-arch-linux-marble-gdm-post.hook" \
        "${pkgdir}/usr/share/libalpm/hooks/zz-arch-linux-marble-gdm-post.hook"
    local version_51_payload="${payload}/51.0.0"
    install -Dm0644 "${source_theme}/gnome-shell.css" "${version_51_payload}/reviewed/gnome-shell.css"
    for css_name in gnome-shell.css gnome-shell-dark.css gnome-shell-light.css; do
        install -Dm0644 "${srcdir}/generated/gnome-shell-51.combined.css" "${version_51_payload}/theme/${css_name}"
    done
    for asset in calendar-event-disabled.svg calendar-event-today.svg calendar-event.svg workspace-placeholder.svg; do
        install -Dm0644 "${source_theme}/${asset}" "${version_51_payload}/theme/${asset}"
    done
    for asset in assets-51.sha256 known-gnome-51.sha256; do
        install -Dm0644 "${srcdir}/${asset}" "${payload}/${asset}"
    done
    install -Dm0644 "${srcdir}/dconf-profile-51" "${version_51_payload}/dconf/profile"
    install -Dm0644 "${srcdir}/generated/colloid-gdm-defaults" "${version_51_payload}/dconf/colloid-gdm-defaults"
    install -Dm0644 "${srcdir}/00-arch-linux-marble-gdm-icons" "${version_51_payload}/dconf/source/00-arch-linux-marble-gdm-icons"
    install -Dm0644 "${srcdir}/icon-theme.lock" "${version_51_payload}/dconf/source/locks/icon-theme"
    install -Dm0644 "${srcdir}/51-arch-linux-marble-gdm.conf" "${payload}/systemd/51-arch-linux-marble-gdm.conf"
    install -Dm0644 "${srcdir}/NOTICE-GNOME-Shell-51-common.scss" \
        "${pkgdir}/usr/share/licenses/${pkgname}/NOTICE-GNOME-Shell-51-common.scss"

    install -Dm0644 "${reviewed_license_root}/COPYING-GNOME-Shell" \
        "${pkgdir}/usr/share/licenses/${pkgname}/COPYING-GNOME-Shell"
    install -Dm0644 "${reviewed_license_root}/COPYING-GNOME-Shell-Sass" \
        "${pkgdir}/usr/share/licenses/${pkgname}/COPYING-GNOME-Shell-Sass"
    install -Dm0644 "${reviewed_license_root}/LICENSE-LGPL-2.1-only" \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-LGPL-2.1-only"
    install -Dm0644 "${reviewed_license_root}/LICENSE-Marble" \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-Marble"
    install -Dm0644 "${reviewed_license_root}/LICENSE-project" \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-project"
    install -Dm0644 "${reviewed_license_root}/NOTICE-GNOME-Shell-common.scss" \
        "${pkgdir}/usr/share/licenses/${pkgname}/NOTICE-GNOME-Shell-common.scss"
    install -Dm0644 "${reviewed_license_root}/THIRD-PARTY-NOTICES" \
        "${pkgdir}/usr/share/licenses/${pkgname}/THIRD-PARTY-NOTICES"
}
