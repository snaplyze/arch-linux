#!/usr/bin/env python3
"""Retire an exact installer-created extension by retaining its original tree."""
from contextlib import contextmanager
import ctypes
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import secrets
import stat
import sys

UUID = 'no-screenshot-box@screenshot'
SYSTEM_ROOT = Path('/usr/share/gnome-shell/extensions')
LEGACY_MANIFEST = Path('/usr/share/arch-linux-gnome-extensions/legacy-no-screenshot-box.sha256')
SYSTEM_MANIFEST = Path('/usr/share/arch-linux-gnome-extensions/extensions.sha256')
DIRECTORY_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
FILE_FLAGS = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC


class UnsafeTree(RuntimeError):
    """An input cannot be proven to be the exact owned tree."""


def identity(info):
    return info.st_dev, info.st_ino, info.st_mode, info.st_uid


def file_identity(info):
    return identity(info) + (info.st_nlink, info.st_size, info.st_mtime_ns, info.st_ctime_ns)


@contextmanager
def directory(path):
    """Open every absolute path component without following symlinks."""
    path = Path(path)
    if not path.is_absolute() or '..' in path.parts:
        raise UnsafeTree('non-absolute or traversing directory')
    fd = os.open('/', DIRECTORY_FLAGS)
    try:
        for component in path.parts[1:]:
            child = os.open(component, DIRECTORY_FLAGS, dir_fd=fd)
            os.close(fd)
            fd = child
        yield fd
    finally:
        os.close(fd)


def owned(info, uid):
    if info.st_uid != uid or info.st_mode & 0o022:
        raise UnsafeTree('foreign ownership or writable permissions')


def read_file(parent, name, uid, limit=16 * 1024 * 1024):
    fd = os.open(name, FILE_FLAGS, dir_fd=parent)
    try:
        before = os.fstat(fd)
        owned(before, uid)
        if not stat.S_ISREG(before.st_mode) or before.st_nlink != 1 or before.st_size > limit:
            raise UnsafeTree('not a bounded, unlinked regular file')
        content = bytearray()
        while chunk := os.read(fd, 65536):
            content.extend(chunk)
            if len(content) > limit:
                raise UnsafeTree('file exceeds size bound')
        after = os.fstat(fd)
        named = os.stat(name, dir_fd=parent, follow_symlinks=False)
        if file_identity(before) != file_identity(after) or file_identity(after) != file_identity(named):
            raise UnsafeTree('file changed during inspection')
        return bytes(content), file_identity(after)
    finally:
        os.close(fd)


def manifest(path, uid, global_paths=False):
    with directory(Path(path).parent) as fd:
        content, _ = read_file(fd, Path(path).name, uid, 1024 * 1024)
    result = {}
    for line in content.decode('ascii').splitlines():
        match = re.fullmatch(r'([0-9a-f]{64})  ([A-Za-z0-9_@.+/-]+)', line)
        if not match:
            raise UnsafeTree('noncanonical manifest')
        digest, name = match.groups()
        parts = name.split('/')
        if any(part in ('', '.', '..') for part in parts) or name in result:
            raise UnsafeTree('duplicate or unsafe manifest path')
        result[name] = digest
    if global_paths:
        result = {name[len(UUID) + 1:]: digest for name, digest in result.items()
                  if name.startswith(UUID + '/')}
    if not result or 'metadata.json' not in result:
        raise UnsafeTree('missing extension manifest')
    return result


def snapshot(fd, expected, uid):
    files, directories = {}, {}
    expected_dirs = {''}
    for name in expected:
        parent = Path(name).parent
        while str(parent) != '.':
            expected_dirs.add(parent.as_posix())
            parent = parent.parent

    def visit(current, prefix):
        info = os.fstat(current)
        owned(info, uid)
        directories[prefix] = identity(info)
        for name in sorted(os.listdir(current)):
            relative = prefix + '/' + name if prefix else name
            info = os.stat(name, dir_fd=current, follow_symlinks=False)
            if stat.S_ISDIR(info.st_mode):
                if relative not in expected_dirs:
                    raise UnsafeTree('unexpected directory')
                child = os.open(name, DIRECTORY_FLAGS, dir_fd=current)
                try:
                    if identity(os.fstat(child)) != identity(info):
                        raise UnsafeTree('directory replaced')
                    visit(child, relative)
                finally:
                    os.close(child)
            elif stat.S_ISREG(info.st_mode) and relative in expected:
                content, key = read_file(current, name, uid)
                if hashlib.sha256(content).hexdigest() != expected[relative]:
                    raise UnsafeTree('modified extension content')
                files[relative] = key
            else:
                raise UnsafeTree('unexpected file, symlink or special file')
    visit(fd, '')
    if set(files) != set(expected) or set(directories) != expected_dirs:
        raise UnsafeTree('incomplete extension tree')
    return files, directories


def restore(custody_fd, parent_fd):
    """Linux rename-noreplace keeps a concurrently recreated destination intact."""
    libc = ctypes.CDLL(None, use_errno=True)
    rename = libc.renameat2
    rename.argtypes = (ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint)
    rename.restype = ctypes.c_int
    if rename(custody_fd, UUID.encode(), parent_fd, UUID.encode(), 1) != 0:
        error = ctypes.get_errno()
        raise OSError(error, os.strerror(error))


def data_home():
    return Path(os.environ.get('XDG_DATA_HOME') or Path.home() / '.local/share')


def migrate(data, system, legacy_manifest, system_manifest, *, uid, system_uid=0):
    parent_path = Path(data) / 'gnome-shell/extensions'
    custody_name = None
    try:
        with directory(parent_path) as parent, directory(parent_path.parent) as custody_parent:
            owned(os.fstat(parent), uid)
            owned(os.fstat(custody_parent), uid)
            try:
                local = os.open(UUID, DIRECTORY_FLAGS, dir_fd=parent)
            except FileNotFoundError:
                return 'system', 'No user-local No Screenshot Box copy shadows the system extension.'
            try:
                legacy = manifest(legacy_manifest, system_uid)
                global_files = manifest(system_manifest, system_uid, global_paths=True)
                with directory(Path(system) / UUID) as system_fd:
                    system_snapshot = snapshot(system_fd, global_files, system_uid)
                    metadata_bytes, _ = read_file(system_fd, 'metadata.json', system_uid)
                    metadata = json.loads(metadata_bytes)
                    if (not isinstance(metadata, dict) or metadata.get('uuid') != UUID
                            or not isinstance(metadata.get('shell-version'), list)
                            or '51' not in metadata['shell-version']):
                        raise UnsafeTree('system extension does not support GNOME 51')
                    if snapshot(system_fd, global_files, system_uid) != system_snapshot:
                        raise UnsafeTree('system extension changed')
                original = snapshot(local, legacy, uid)
                lock = os.open('.arch-linux-marble-extensions.lock',
                               os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC,
                               0o600, dir_fd=parent)
                try:
                    lock_info = os.fstat(lock)
                    owned(lock_info, uid)
                    if not stat.S_ISREG(lock_info.st_mode) or lock_info.st_nlink != 1:
                        raise UnsafeTree('unsafe migration lock')
                    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    if snapshot(local, legacy, uid) != original:
                        raise UnsafeTree('local extension changed')
                    if identity(os.stat(UUID, dir_fd=parent, follow_symlinks=False)) != original[1]['']:
                        raise UnsafeTree('local extension replaced')
                    custody_name = '.arch-linux-marble-custody-' + secrets.token_hex(16)
                    custody_path = parent_path.parent / custody_name
                    os.mkdir(custody_name, 0o700, dir_fd=custody_parent)
                    custody = os.open(custody_name, DIRECTORY_FLAGS, dir_fd=custody_parent)
                    custody_identity = identity(os.fstat(custody))
                    try:
                        owned(os.fstat(custody), uid)
                        os.rename(UUID, UUID, src_dir_fd=parent, dst_dir_fd=custody)
                        try:
                            # Bind the moved name as well as the retained descriptor.
                            if identity(os.stat(UUID, dir_fd=custody, follow_symlinks=False)) != original[1]['']:
                                raise UnsafeTree('moved extension replaced')
                            if os.path.lexists(parent_path / UUID):
                                raise UnsafeTree('user-local destination recreated')
                            with directory(Path(system) / UUID) as system_fd:
                                if snapshot(system_fd, global_files, system_uid) != system_snapshot:
                                    raise UnsafeTree('system replacement changed before retirement')
                            if snapshot(local, legacy, uid) != original:
                                raise UnsafeTree('local extension changed during retirement')
                            # Keep the original directory and every leaf. A writer holding
                            # an old FD can still customize it after the final inspection;
                            # retaining its pathname prevents check-then-unlink data loss.
                        except (OSError, UnsafeTree):
                            try:
                                restore(custody, parent)
                            except (OSError, AttributeError):
                                return 'shadowed', 'Changed extension retained in private custody: ' + str(custody_path)
                            raise UnsafeTree('concurrent change; user-local extension restored')
                    finally:
                        os.close(custody)
                        try:
                            info = os.stat(custody_name, dir_fd=custody_parent, follow_symlinks=False)
                            if identity(info) == custody_identity:
                                os.rmdir(custody_name, dir_fd=custody_parent)
                        except OSError:
                            pass  # A retained original tree must never be discarded.
                finally:
                    os.close(lock)
                return 'migrated', ('Retired the exact installer-created No Screenshot Box 6 tree; '
                                    'original retained at ' + str(custody_path / UUID) + '; system extension selected.')
            finally:
                os.close(local)
    except FileNotFoundError:
        if not os.path.lexists(parent_path / UUID):
            return 'system', 'No user-local No Screenshot Box copy shadows the system extension.'
        return 'shadowed', 'User-local No Screenshot Box preserved: verified system replacement is unavailable.'
    except (OSError, UnsafeTree, ValueError, UnicodeError) as error:
        return 'shadowed', 'User-local No Screenshot Box preserved (shadowed): ' + str(error)


def main():
    if os.geteuid() == 0:
        print('No Screenshot Box migration must run as the session user, never root.', file=sys.stderr)
        return 1
    status, message = migrate(data_home(), SYSTEM_ROOT, LEGACY_MANIFEST, SYSTEM_MANIFEST, uid=os.geteuid())
    print(status + ': ' + message)
    return 0


if __name__ == '__main__':
    sys.exit(main())
