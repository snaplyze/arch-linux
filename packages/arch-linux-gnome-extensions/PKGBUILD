pkgname=arch-linux-gnome-extensions
pkgver=1.0.0
pkgrel=1
pkgdesc='Reviewed GNOME extension collection with safe legacy user-copy migration'
arch=('any')
url='https://github.com/snaplyze/arch-linux'
license=('GPL-3.0-only AND GPL-2.0-or-later AND BSD-1-Clause AND MIT AND GPL-3.0-or-later')
depends=(
    'arch-linux-keyring>=1.0.0'
    'gnome-shell'
    'gnome-shell-extension-appindicator'
    'gnome-shell-extension-caffeine'
    'python'
    'systemd'
)
makedepends=('glib2' 'gettext')
provides=(
    'gnome-shell-extension-dash-to-dock=1:109'
    'gnome-shell-extension-blur-my-shell=74'
    'gnome-shell-extension-just-perfection-desktop=37'
    'gnome-shell-extension-clipboard-indicator=71'
)
conflicts=(
    'gnome-shell-extension-dash-to-dock'
    'gnome-shell-extension-blur-my-shell'
    'gnome-shell-extension-just-perfection-desktop'
    'gnome-shell-extension-clipboard-indicator'
)
replaces=(
    'gnome-shell-extension-dash-to-dock'
    'gnome-shell-extension-blur-my-shell'
    'gnome-shell-extension-just-perfection-desktop'
    'gnome-shell-extension-clipboard-indicator'
)
options=('!strip' '!debug')

source=(
