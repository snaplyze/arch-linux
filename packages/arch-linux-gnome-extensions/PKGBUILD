prepare() {
    # makepkg exposes noextract inputs through symlinks. Materialize its verified
    # archives in the disposable build tree; the bounded reader still rejects links.
    local archive
    install -d "${srcdir}/extension-inputs"
    for archive in "${noextract[@]}"; do
        install -m0644 "${srcdir}/${archive}" "${srcdir}/extension-inputs/${archive}"
    done
    python "${srcdir}/prepare-extensions.py" --input-dir "${srcdir}/extension-inputs" \
        --output-dir "${srcdir}/extensions"
}

check() {
    (cd "${srcdir}/extensions" && sha256sum --check --strict "${srcdir}/extensions.sha256")
}

package() {
    install -d "${pkgdir}/usr/lib/systemd/user/gnome-session-pre.target.wants"
    install -Dm0755 "${srcdir}/extension-session" \
        "${pkgdir}/usr/lib/arch-linux-gnome-extensions/extension-session"
    install -Dm0644 "${srcdir}/arch-linux-gnome-extensions.service" \
        "${pkgdir}/usr/lib/systemd/user/arch-linux-gnome-extensions.service"
    ln -s ../arch-linux-gnome-extensions.service \
        "${pkgdir}/usr/lib/systemd/user/gnome-session-pre.target.wants/arch-linux-gnome-extensions.service"
    local manifest
    for manifest in extensions.sha256 legacy-no-screenshot-box.sha256; do
        install -Dm0644 "${srcdir}/${manifest}" \
            "${pkgdir}/usr/share/arch-linux-gnome-extensions/${manifest}"
    done
    install -d "${pkgdir}/usr/share/gnome-shell/extensions"
    cp -a -- "${srcdir}/extensions/." "${pkgdir}/usr/share/gnome-shell/extensions/"
    install -Dm0644 "${srcdir}/THIRD-PARTY-EXTENSIONS" \
        "${pkgdir}/usr/share/licenses/${pkgname}/THIRD-PARTY-EXTENSIONS"
    install -Dm0644 "${srcdir}/extensions/dash-to-dock@micxgx.gmail.com/COPYING" \
        "${pkgdir}/usr/share/licenses/${pkgname}/dash-to-dock@micxgx.gmail.com.license"
    install -Dm0644 "${srcdir}/extensions/blur-my-shell@aunetx/LICENSE" \
        "${pkgdir}/usr/share/licenses/${pkgname}/blur-my-shell@aunetx.license"
    install -Dm0644 "${srcdir}/extensions/just-perfection-desktop@just-perfection/LICENSE" \
        "${pkgdir}/usr/share/licenses/${pkgname}/just-perfection-desktop@just-perfection.license"
    install -Dm0644 "${srcdir}/extensions/clipboard-indicator@tudmotu.com/LICENSE.rst" \
        "${pkgdir}/usr/share/licenses/${pkgname}/clipboard-indicator@tudmotu.com.license"
    install -Dm0644 "${srcdir}/extensions/no-screenshot-box@screenshot/LICENSE" \
        "${pkgdir}/usr/share/licenses/${pkgname}/no-screenshot-box@screenshot.license"
    install -Dm0644 "${srcdir}/LICENSE-project"         "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-project"
}
