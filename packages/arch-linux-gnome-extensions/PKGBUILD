    'extension-session'
    'arch-linux-gnome-extensions.service'
    'dash-to-dock.zip::https://extensions.gnome.org/download-extension/dash-to-dock@micxgx.gmail.com.shell-extension.zip?version_tag=75334'
    'blur-my-shell.zip::https://extensions.gnome.org/download-extension/blur-my-shell@aunetx.shell-extension.zip?version_tag=75939'
    'just-perfection.zip::https://extensions.gnome.org/download-extension/just-perfection-desktop@just-perfection.shell-extension.zip?version_tag=74466'
    'clipboard-indicator.tar.gz::https://codeload.github.com/Tudmotu/gnome-shell-extension-clipboard-indicator/tar.gz/39a0f9077daca21a62adaa975eb6a03bda499f27'
    'no-screenshot-box.tar.gz::https://codeload.github.com/abdallah-alkanani/no-screenshot-box/tar.gz/049690c3a003afd005fad5459f783ba3f46cdb81'
    'no-screenshot-box-old.zip::https://extensions.gnome.org/download-extension/no-screenshot-box@screenshot.shell-extension.zip?version_tag=72860'
)
noextract=(
    'dash-to-dock.zip'
    'blur-my-shell.zip'
    'just-perfection.zip'
    'clipboard-indicator.tar.gz'
    'no-screenshot-box.tar.gz'
    'no-screenshot-box-old.zip'
)
