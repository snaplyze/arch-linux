# shellcheck shell=bash disable=SC2016,SC2034,SC2100,SC2154
# Maintainer: snaplyze <snaplyze@users.noreply.github.com>

pkgname=arch-linux-colloid-icons
pkgver=20260817
pkgrel=1
pkgdesc='Reviewed Colloid blue icon themes for the arch-linux Marble profile'
arch=('any')
url='https://github.com/vinceliuice/Colloid-icon-theme'
license=('GPL-3.0-only')
depends=('hicolor-icon-theme' 'gtk-update-icon-cache')
options=('!strip' '!debug')

_upstream_commit='fa07485895a2443f7cfbceefe9dcdde798a05215'
source=("${pkgname}-${_upstream_commit}.tar.gz::https://github.com/vinceliuice/Colloid-icon-theme/archive/${_upstream_commit}.tar.gz")
sha256sums=('27be4c8bf046bdfcac592b691b42abd38fda3dccb2659a46b77ecb7c7dc5eee7')

prepare() {
    local upstream="${srcdir}/Colloid-icon-theme-${_upstream_commit}"
    local cache_call='  gtk-update-icon-cache "${THEME_DIR}"'

    # A package must not own the mutable icon-theme.cache generated by the system pacman hook.
    # Verify the one reviewed upstream call before disabling build-time cache generation.
    test "$(grep -Fxc -- "${cache_call}" "${upstream}/install.sh")" -eq 1
    sed -i '\|^  gtk-update-icon-cache "${THEME_DIR}"$|d' "${upstream}/install.sh"
}

package() {
    local upstream="${srcdir}/Colloid-icon-theme-${_upstream_commit}"
    local icon_root="${pkgdir}/usr/share/icons"

    # The reviewed commit contains one dangling obsolete application alias. Verify the exact
    # defect before removing it from the staged source; this keeps the generated icon caches in
    # sync and turns any upstream change into a deliberate package review.
    local kerry_link="${upstream}/links/apps/scalable/kerry.svg"
    test -L "${kerry_link}"
    test "$(readlink -- "${kerry_link}")" = 'search.svg'
    rm -f -- "${kerry_link}"

    bash "${upstream}/install.sh" --dest "${icon_root}" --theme default

    # Resolve the one link which upstream routes through a symlinked directory. The original is
    # valid on disk, but a direct equivalent target keeps archive validators and pacman tooling
    # from treating it as dangling.
    local rating_link="${icon_root}/Colloid-Dark/status/16/rating-unrated.svg"
    test -L "${rating_link}"
    test "$(readlink -- "${rating_link}")" = '../../emblems/16/rating-unrated.svg'
    ln -sfn -- '../../../Colloid-Light/emblems/16/rating-unrated.svg' "${rating_link}"

    local broken_link
    broken_link="$(find -L "${icon_root}" -type l -print -quit)"
    if [ -n "${broken_link}" ]; then
        printf 'Unexpected dangling icon link: %s\n' "${broken_link}" >&2
        return 1
    fi

    for theme in Colloid Colloid-Light Colloid-Dark; do
        test -f "${icon_root}/${theme}/index.theme"
        test ! -e "${icon_root}/${theme}/icon-theme.cache"
    done

    install -Dm0644 "${upstream}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
