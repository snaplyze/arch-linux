[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = gnome-shell
Target = gtk4
Target = libadwaita
Target = arch-linux-marble-shell
Target = arch-linux-colloid-gtk
Target = arch-linux-colloid-icons

[Action]
Description = Revalidate the Marble profile for the installed GNOME major...
When = PostTransaction
Depends = dconf
Exec = /usr/lib/arch-linux-marble-profile/update-compatibility
