# shellcheck shell=bash disable=SC2034,SC2100,SC2154
# Maintainer: snaplyze <snaplyze@users.noreply.github.com>

pkgname=arch-linux-keyring
pkgver=1.0.0
pkgrel=7
pkgdesc='Public certificate refresh path for the signed arch-linux repository'
arch=('any')
url='https://github.com/snaplyze/arch-linux'
license=('GPL-3.0-only')
depends=('pacman')
install='arch-linux-keyring.install'
options=('!strip' '!debug')

# makepkg resolves the public trust sources from SRCDEST. repository/build-packages.sh stages the
# three canonical files from repository/trust, keeping the keyring package bound to the installer
# bootstrap certificate and the reviewed literal SHA-256 values below.
source=(
    'arch-linux.gpg'
    'primary-fingerprint'
    'signing-subkey-fingerprint'
    'arch-linux-keyring.install'
    'LICENSE-project'
)
# BEGIN INITIAL TRUST V1 CHECKSUMS
sha256sums=(
    '8959dfd96fd94349d505f18a6d3ef0a3bfcd9fad53291343388f787f9dbb9c6f'
    '7e12b5e2a2ce9ed2881e06d80054a969465eea72f917282f25f27ae02cf66824'
    '471e476b51923eb1afe73609a7ef4aef3fbc1e1c2b09ba3f77e9f1f349643b69'
    '95552a4bda2ac67bd5b957fadaa318bd14237a303b577cd097b69933d5a15e87'
    '3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986'
)
# END INITIAL TRUST V1 CHECKSUMS

package() {
    install -Dm0644 "${srcdir}/arch-linux.gpg" \
        "${pkgdir}/usr/share/pacman/keyrings/arch-linux.gpg"
    install -Dm0644 "${srcdir}/primary-fingerprint" \
        "${pkgdir}/usr/share/arch-linux-keyring/primary-fingerprint"
    install -Dm0644 "${srcdir}/signing-subkey-fingerprint" \
        "${pkgdir}/usr/share/arch-linux-keyring/signing-subkey-fingerprint"
    install -Dm0644 "${srcdir}/LICENSE-project" \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-project"
}
